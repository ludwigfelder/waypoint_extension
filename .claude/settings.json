{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/waypoint_gate_prompt.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
